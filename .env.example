# Generated into INSTALL_DIR/.env by setup (envsubst).
# Credentials go under secrets/, not here.

# Host user/group that owns media files
PUID=${PUID}
PGID=${PGID}

MEDIA_DIRECTORY=${MEDIA_DIRECTORY}
INSTALL_DIRECTORY=${INSTALL_DIRECTORY}

# jellyfin | emby | plex
MEDIA_SERVICE=${MEDIA_SERVICE}

# IANA timezone (e.g. Europe/Athens)
TZ=${TZ}

# y/n — secrets under secrets/ when enabled
VPN_ENABLED=${VPN_ENABLED}
# Gluetun provider id (e.g. protonvpn)
VPN_SERVICE=${VPN_SERVICE}
# openvpn | wireguard
VPN_TYPE=${VPN_TYPE}

# WireGuard only (not secret)
WIREGUARD_ADDRESSES=${WIREGUARD_ADDRESSES}

# on/off — only if your provider supports it
PORT_FORWARD_ONLY=${PORT_FORWARD_ONLY}
VPN_PORT_FORWARDING=${VPN_PORT_FORWARDING}

# configure.sh API host
API_HOST=${API_HOST}
