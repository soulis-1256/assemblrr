# Assemblrr Environment Configuration
# This file documents all available environment variables.
# Actual values are generated by setup.sh using envsubst.

# User/Group IDs — must match the user that owns the media files
PUID=1000
PGID=1000

# Paths (defaults are home-based; set during setup)
MEDIA_DIRECTORY=/home/<user>/assemblrr-media
INSTALL_DIRECTORY=/home/<user>/assemblrr

# Media service: jellyfin, emby, or plex
MEDIA_SERVICE=jellyfin

# Timezone (IANA format)
TZ=UTC

# VPN Configuration
VPN_ENABLED=n
VPN_SERVICE=protonvpn
VPN_TYPE=openvpn

# OpenVPN credentials are stored in secrets/openvpn_user.txt and secrets/openvpn_password.txt
# WireGuard private key is stored in secrets/wireguard_private_key.txt
# These are NOT in .env — they are mounted as Docker secrets so docker inspect won't expose them.

# WireGuard addresses (not secret, just an internal IP)
WIREGUARD_ADDRESSES=

# Port forwarding (only supported by some VPN providers)
PORT_FORWARD_ONLY=off
VPN_PORT_FORWARDING=off

# API Host for configuration script (advanced users)
API_HOST=127.0.0.1
