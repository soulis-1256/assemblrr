# Custom services overlay — NOT officially supported.
# Rename this file to custom.yaml to add extra containers. They join assemblrr_network
# (.30+ IPs reserved for custom services) and are left untouched by assemblrr upgrades.
# Official core stack: Jellyfin + qBittorrent + Sonarr/Radarr/Prowlarr/Bazarr/Seerr/Recyclarr
# + optional overlays (vuetorrent, gpu-intel/gpu-nvidia, byparr, usenet, vpn).

networks:
  default:
    external: true
    name: assemblrr_network

services:

  # --- Emby (optional self-managed custom service; conflicts with Jellyfin 8096 unless remapped) ---
  # Web UI: http://<host>:8097
  # emby:
  #   image: lscr.io/linuxserver/emby:4.9.3.0
  #   container_name: emby
  #   environment:
  #     - PUID=${PUID}
  #     - PGID=${PGID}
  #     - TZ=${TZ}
  #   volumes:
  #     - /etc/localtime:/etc/localtime:ro
  #     - ${MEDIA_DIRECTORY}:/data
  #     - ${INSTALL_DIRECTORY}/config/emby:/config
  #   ports:
  #     - 8097:8096
  #   restart: unless-stopped
  #   networks:
  #     assemblrr_network:
  #       ipv4_address: 172.60.0.30

  # --- Plex (optional self-managed custom service; uses host networking for DLNA/claim) ---
  # Web UI: http://<host>:32400/web
  # plex:
  #   image: lscr.io/linuxserver/plex:1.43.0
  #   container_name: plex
  #   network_mode: host
  #   environment:
  #     - PUID=${PUID}
  #     - PGID=${PGID}
  #     - TZ=${TZ}
  #     - VERSION=docker
  #   volumes:
  #     - /etc/localtime:/etc/localtime:ro
  #     - ${MEDIA_DIRECTORY}:/data
  #     - ${INSTALL_DIRECTORY}/config/plex:/config
  #   restart: unless-stopped

  # --- Lidarr — Music management and automation ---
  # Requires: Prowlarr indexer + download client (configure manually in Lidarr UI)
  # Web UI: http://<host>:8686
  # lidarr:
  #   image: lscr.io/linuxserver/lidarr:3.1.0
  #   container_name: lidarr
  #   environment:
  #     - PUID=${PUID}
  #     - PGID=${PGID}
  #     - TZ=${TZ}
  #   volumes:
  #     - /etc/localtime:/etc/localtime:ro
  #     - ${MEDIA_DIRECTORY}:/data
  #     - ${INSTALL_DIRECTORY}/config/lidarr:/config
  #   ports:
  #     - 8686:8686
  #   restart: unless-stopped
  #   networks:
  #     assemblrr_network:
  #       ipv4_address: 172.60.0.32

  # --- Komodo Periphery — connect this host to a Komodo dashboard (see docs/komodo.md) ---
  # periphery:
  #   image: ghcr.io/moghtech/komodo-periphery:1.19
  #   container_name: komodo-periphery
  #   environment:
  #     - TZ=${TZ}
  #   volumes:
  #     - /var/run/docker.sock:/var/run/docker.sock
  #     - ${INSTALL_DIRECTORY}:${INSTALL_DIRECTORY}
  #   ports:
  #     - 8120:8120
  #   restart: unless-stopped
  #   networks:
  #     assemblrr_network:
  #       ipv4_address: 172.60.0.33
